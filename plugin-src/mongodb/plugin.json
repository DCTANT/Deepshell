{
  "id": "com.deepshell.mongodb",
  "name": "MongoDB 管理器",
  "version": "1.0.0",
  "description": "面向 DeepShell AI 桌面的 MongoDB 浏览与调试工具：保存连接（密码加密）、数据库与集合浏览、文档查询编辑、索引管理、统计与命令控制台。",
  "author": "DeepShell",
  "icon": "icon.svg",
  "entry": "index.html",
  "window": {
    "width": 1280,
    "height": 800,
    "title": "MongoDB 管理器"
  },
  "backend": {
    "jars": [
      "backend/mongodb-backend.jar",
      "backend/lib/mongodb-driver-sync-5.2.1.jar",
      "backend/lib/mongodb-driver-core-5.2.1.jar",
      "backend/lib/bson-5.2.1.jar"
    ],
    "main": "com.itdct.deepshell.plugin.mongodb.MongoPluginModule"
  }
}
