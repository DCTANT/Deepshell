{
  "id": "com.deepshell.kafka",
  "name": "Kafka 管理器",
  "version": "1.0.0",
  "description": "面向 DeepShell AI 桌面的 Kafka 运维工具：保存连接（密码加密）、集群概览、主题与分区浏览、消息拉取与发送、消费组状态与堆积检查。",
  "author": "DeepShell",
  "icon": "icon.svg",
  "entry": "index.html",
  "window": {
    "width": 1260,
    "height": 780,
    "title": "Kafka 管理器"
  },
  "backend": {
    "jars": [
      "backend/kafka-backend.jar",
      "backend/lib/kafka-clients-3.7.1.jar",
      "backend/lib/lz4-java-1.8.0.jar",
      "backend/lib/snappy-java-1.1.10.5.jar",
      "backend/lib/zstd-jni-1.5.5-6.jar"
    ],
    "main": "com.itdct.deepshell.plugin.kafka.KafkaPluginModule"
  }
}
